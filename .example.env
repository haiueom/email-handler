# Discord webhook URL for email notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# Telegram bot token + chat ID for notifications (both required together)
# Create a bot with @BotFather, then get your chat ID from @userinfobot
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHAT_ID=123456789

# Fallback email address — raw email is forwarded here if processing fails
FALLBACK_EMAIL=you@example.com

# API token for authenticating requests to the email handler
API_TOKEN=your-secret-token-here

# Comma-separated exact sender addresses to block (case-insensitive)
# BLOCKED_EMAILS=spam@example.com,scam@test.com

# Comma-separated domain patterns to block (* = wildcard)
# BLOCK_PATTERNS=spam.com,*.spam.com